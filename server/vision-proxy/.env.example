# Anthropic API key (server-side only; never put this in the app)
ANTHROPIC_API_KEY=
# Comma-separated tokens the app sends as "Authorization: Bearer <token>".
# Required: the server refuses to start without it.
APP_TOKENS=
# Local development ONLY: set to 1 to run without auth. The server then listens on 127.0.0.1
# only and refuses to start if NODE_ENV=production. Never set this on a deployed host.
# ALLOW_NO_AUTH=1
PORT=8787
# Requests per token per hour
RATE_LIMIT_PER_HOUR=30
# Model used for map analysis
VISION_MODEL=claude-opus-5-5
# Ceiling for one Claude call in ms (default 240000, allowed 30000-270000). The app waits 300 s,
# so the proxy must always give up first. Raise your host's request timeout to 300 s or more.
VISION_TIMEOUT_MS=240000
