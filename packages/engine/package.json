{
  "name": "@msp/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Mature Buck Stand Planner rules engine: pure TypeScript, no runtime dependencies, unit-tested with node:test.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.8.0"
  }
}